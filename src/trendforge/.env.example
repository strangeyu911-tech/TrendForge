# ============================================================
# TrendForge 环境变量配置示例
# 复制为 .env 并填入真实值。支持 6 家 LLM 厂商，可同时配置多个。
# ============================================================

# ---- 当前激活的对话厂商 ----
# 可选: openai | anthropic | deepseek | kimi | qwen | glm
TF_LLM_VENDOR=openai

# ---- 通用 key（任一厂商都可用，优先级低于各厂商独立 key）----
TF_LLM_API_KEY=

# ---- 各厂商独立 key（推荐：配哪家填哪家，互不干扰）----
TF_OPENAI_API_KEY=
TF_ANTHROPIC_API_KEY=
TF_DEEPSEEK_API_KEY=
TF_KIMI_API_KEY=
TF_QWEN_API_KEY=
TF_GLM_API_KEY=

# ---- 可选：覆盖厂商默认 base_url / 模型（留空用内置默认）----
# TF_LLM_BASE_URL=
# TF_LLM_MODEL=

# ---- 可选：各 Agent 差异化选型（留空 = 用厂商默认模型）----
# 例：Writer 用强模型，Reviewer 用便宜的
# TF_PLANNER_MODEL=
# TF_WRITER_MODEL=
# TF_REVIEWER_MODEL=
# TF_RESEARCH_MODEL=
# TF_PUBLISHER_MODEL=

# ============================================================
# 各厂商快速配置示例（取消注释并填 key 即可）
# ============================================================

# ---- OpenAI ----
# TF_LLM_VENDOR=openai
# TF_OPENAI_API_KEY=sk-xxx
# TF_LLM_MODEL=gpt-4o-mini

# ---- Anthropic Claude（原生 Messages API）----
# TF_LLM_VENDOR=anthropic
# TF_ANTHROPIC_API_KEY=sk-ant-xxx
# TF_LLM_MODEL=claude-3-5-haiku-20241022

# ---- DeepSeek 深度求索 ----
# TF_LLM_VENDOR=deepseek
# TF_DEEPSEEK_API_KEY=sk-xxx
# TF_LLM_MODEL=deepseek-chat

# ---- Kimi 月之暗面 ----
# TF_LLM_VENDOR=kimi
# TF_KIMI_API_KEY=sk-xxx
# TF_LLM_MODEL=moonshot-v1-8k

# ---- Qwen 通义千问（DashScope 兼容模式）----
# TF_LLM_VENDOR=qwen
# TF_QWEN_API_KEY=sk-xxx
# TF_LLM_MODEL=qwen-plus

# ---- GLM 智谱清言 ----
# TF_LLM_VENDOR=glm
# TF_GLM_API_KEY=xxx.xxx
# TF_LLM_MODEL=glm-4-flash

# ============================================================
# Embedding（独立于对话厂商，留空 key 自动用本地 MiniLM，零配置）
# 注意：切换 embedding 模型后需重新入库（维度不同会导致检索失效）
# ============================================================
# TF_EMBEDDING_VENDOR=openai
# TF_EMBEDDING_API_KEY=
# TF_EMBEDDING_BASE_URL=
# TF_EMBEDDING_MODEL=text-embedding-3-small

# ---- 服务（可选）----
TF_HOST=0.0.0.0
TF_PORT=8000
TF_DEBUG=true
